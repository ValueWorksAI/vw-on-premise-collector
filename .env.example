# Azure Blob Storage (shared across all sources unless a source overrides it)
AZURE_STORAGE_URL=https://<account>.blob.core.windows.net
AZURE_STORAGE_SAS_TOKEN=?sv=...&sig=...

# Path to AzCopy executable.
# Defaults: Windows C:\AzCopy\azcopy.exe, Linux `azcopy` on PATH.
#AZCOPY_PATH=C:\AzCopy\azcopy.exe
#AZCOPY_PATH=/usr/local/bin/azcopy

# Log directory. Defaults: Windows C:\logs\vw-on-prem-collector, Linux <repo>/logs.
#VW_LOG_DIR=/var/log/vw-on-prem-collector

# --- Per-source secrets ---
# Naming convention: <SOURCE_NAME>_<KEY>, uppercased.
# Referenced from sources/<name>/config.yaml as ${env:EXAMPLE_PASSWORD}.

EXAMPLE_USERNAME=user
EXAMPLE_PASSWORD=changeme

# MSSQL source example (see sources/_example_mssql/):
EXAMPLE_MSSQL_HOST=sqlserver.internal
EXAMPLE_MSSQL_DATABASE=SomeDb
EXAMPLE_MSSQL_USERNAME=vw_readonly
EXAMPLE_MSSQL_PASSWORD=changeme
